{
  // we try to make semantic highlighting look good
  "editor.semanticHighlighting.enabled": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "catppuccin.italicKeywords": false,
  "catppuccin.boldKeywords": true,
  // prevent VSCode from modifying the terminal colors
  "terminal.integrated.minimumContrastRatio": 1,
  // make the window's titlebar use the workbench colors
  "window.titleBarStyle": "custom",
    "files.exclude": {
        "**/.git": true,
        "**/tmp": true
    },
    "editor.cursorSurroundingLines": 1000,
    // applicable if you use Go, this is an opt-in flag!
    "gopls": {
        "ui.semanticTokens": true
    },
    "window.autoDetectColorScheme": true,
    "git.mergeEditor": false,
    "go.formatTool": "goimports",
    "editor.wordWrap": "on",
    "editor.lineNumbers": "on",
    "editor.scrollbar.horizontal": "hidden",
    "editor.hideCursorInOverviewRuler": true,
    "editor.overviewRulerBorder": false,
    "gitlens.hovers.currentLine.over": "line",
    "editor.codeLens": true,
    "editor.tabSize": 2,
    "editor.fontLigatures": true,
    "editor.letterSpacing": 0.4,
    "editor.smoothScrolling": true,
    "editor.rulers": [
        120
    ],
    "explorer.autoRevealExclude": {
        "**/node_modules": true,
        "**/bower_components": true
    },
    "typescript.referencesCodeLens.enabled": true,
    "go.useLanguageServer": true,
    "editor.minimap.enabled": false,
    "editor.formatOnType": true,
    "debug.console.fontSize": 14,
    "editor.formatOnPaste": true,
    "editor.formatOnSaveMode": "modifications",
    "editor.cursorBlinking": "solid",
    "editor.fontSize": 14,
    "editor.cursorStyle": "block",
    "typescript.preferences.importModuleSpecifier": "project-relative",
    "terminal.integrated.fontSize": 13,
    "githubPullRequests.pullBranch": "never",
    "go.toolsManagement.autoUpdate": true,
    "workbench.iconTheme": "icons",
    "git.autofetch": true,
    "editor.inlineSuggest.enabled": true,
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "git.confirmSync": false,
    "[typescriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "workbench.startupEditor": "none",
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "window.commandCenter": false,
    "gitlens.currentLine.enabled": false,
    "window.zoomLevel": 2,
    "vsicons.dontShowNewVersionMessage": true,
    "cSpell.userWords": [
      "amqp",
      "bson",
      "codecast",
      "codecasts",
      "curr",
      "Deregistering",
      "ecom",
      "fanout",
      "genproto",
      "godotenv",
      "grpcapp",
      "grpcgateway",
      "inmem",
      "logrus",
      "mygit",
      "mypassword",
      "nums",
      "omsv",
      "oneof",
      "otel",
      "otelgrpc",
      "otlptrace",
      "otlptracehttp",
      "projectmanager",
      "rabbitmq",
      "readpref",
      "semconv",
      "sess",
      "sikozonpc",
      "splitted",
      "Subrouter",
      "tmpl",
      "unbuffered",
      "unmarshalling"
    ],
    "github.copilot.advanced": {},
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "security.workspace.trust.untrustedFiles": "open",
    "[templ]": {
        "editor.defaultFormatter": "a-h.templ"
    },
    "tailwindCSS.includeLanguages": {
        "templ": "html"
    },
    "alpine-intellisense.settings.languageScopes": [
        "templ"
    ],
    "github.copilot.editor.enableAutoCompletions": true,
    "git.openRepositoryInParentFolders": "never",
    // "workbench.preferredLightColorTheme": "Gruvbox Dark Hard",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "workbench.statusBar.visible": false,
    "cursor.cpp.disabledLanguages": [
        "scminput"
    ],
    "makefile.configureOnOpen": false,
    "redhat.telemetry.enabled": false,
    "[yaml]": {
      "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "vs-kubernetes": {
      "vscode-kubernetes.minikube-path-mac": "/Users/tiago/.vs-kubernetes/tools/minikube/darwin-arm64/minikube",
      "vscode-kubernetes.helm-path-mac": "/Users/tiago/.vs-kubernetes/tools/helm/darwin-arm64/helm",
      "vs-kubernetes.minikube-show-information-expiration": "2025-12-13T10:21:33.428Z"
    },
    "workbench.preferredLightColorTheme": "Gruvbox Dark Hard",
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "cSpell.enabledNotifications": {
      "Average Word Length too Long": false,
      "Maximum Word Length Exceeded": false,
      "Lines too Long": false
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.experimental.useTrueInlineView": true,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "workbench.editor.editorActionsLocation": "titleBar",
    "workbench.preferredDarkColorTheme": "Gruvbox Dark Hard",
    "claudeCode.selectedModel": "default",
    "claudeCode.preferredLocation": "panel"
}
